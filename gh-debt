#!/usr/bin/env node
/**
 * gh-debt executable for GitHub CLI extension.
 *
 * `gh extension install <owner>/<repo>` clones the repository, so a fresh
 * install has no `dist/`. Build the bundle on demand when it is missing —
 * a committed, up-to-date `dist/` makes this a no-op.
 *
 * After changing anything under `src/`, run `npm run build` in the checkout.
 */

import { existsSync } from 'node:fs'
import { execFileSync } from 'node:child_process'
import { fileURLToPath } from 'node:url'
import { dirname, join } from 'node:path'

const root = dirname(fileURLToPath(import.meta.url))
const bundlePath = join(root, 'dist', 'cli.mjs')

if (!existsSync(bundlePath)) {
  console.error('gh-debt: no bundle found, building (first run only)…')
  execFileSync('npm', ['install', '--no-audit', '--no-fund', '--loglevel', 'error'], {
    cwd: root,
    stdio: 'inherit',
  })
  execFileSync('npm', ['run', 'build'], { cwd: root, stdio: 'inherit' })
}

await import(bundlePath)
