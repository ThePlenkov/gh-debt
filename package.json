{
  "name": "gh-debt",
  "version": "0.1.0",
  "description": "GitHub CLI extension for tracking and managing technical debt — PRs awaiting review, assigned issues, and stale items across all your repositories, prioritized by date",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "bin": {
    "gh-debt": "dist/cli.mjs"
  },
  "keywords": [
    "gh-extension",
    "github-cli",
    "technical-debt",
    "pr-review",
    "issue-tracking",
    "stale"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThePlenkov/gh-debt.git"
  },
  "bugs": {
    "url": "https://github.com/ThePlenkov/gh-debt/issues"
  },
  "homepage": "https://github.com/ThePlenkov/gh-debt#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
