{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "tools",
  "sourceRoot": "tools",
  "targets": {
    "release": {
      "executor": "@nx-devkit/release:publish",
      "options": {
        "packagePath": ".",
        "packageName": "gh-debt"
      },
      "configurations": {
        "patch": {
          "version": "patch"
        },
        "minor": {
          "version": "minor"
        },
        "major": {
          "version": "major"
        }
      },
      "defaultConfiguration": "patch"
    }
  }
}
