# sverka's per-step working directory (.sverka/workspace/<pipeline>/<step>/.outputs).
# The @nx-devkit/sverka plugin already excludes it from target inputs, so it must
# not reach git either — it only accumulates empty scratch trees.
.sverka/

*.tsbuildinfo
*.log
.DS_Store

# Agent skills live in .agents/skills/ and are generated from skills-lock.json,
# which is the source of truth and IS committed. Restore them with:
#   npx skills experimental_install
.agents/
